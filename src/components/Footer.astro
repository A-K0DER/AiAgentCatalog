---
import { CATEGORIES } from "../data/categories";

const year = new Date().getFullYear();

const columns = [
  {
    label: "Catalog",
    links: [
      { href: "/skills/", label: "Browse Skills" },
      { href: "/mcps/", label: "Browse MCPs" },
      { href: "/categories/", label: "All Categories" },
    ],
  },
  {
    label: "Categories",
    links: CATEGORIES.slice(0, 5).map((c) => ({
      href: `/skills/category/${c.slug}/`,
      label: c.label,
    })),
  },
  {
    label: "Resources",
    links: [
      { href: "/about/", label: "About & Verification" },
      { href: "/faq/", label: "FAQ" },
      { href: "/submit/", label: "Submit a Listing" },
      { href: "https://github.com", label: "GitHub" },
    ],
  },
  {
    label: "Legal",
    links: [
      { href: "/contact/", label: "Contact Us" },
      { href: "/privacy/", label: "Privacy Policy" },
      { href: "/terms/", label: "Terms & Conditions" },
    ],
  },
];
---

<footer class="border-t border-hairline bg-canvas py-4xl">
  <div class="container-page">
    <div class="grid grid-cols-2 gap-xl sm:grid-cols-3 lg:grid-cols-6">
      <div class="col-span-2 flex flex-col gap-sm sm:col-span-3 lg:col-span-2">
        <span class="text-display-sm text-ink">SkillForAgents</span>
        <p class="max-w-[20rem] text-body-sm text-body">
          The open, verified catalog of Claude Agent Skills and MCP servers — browsable by
          use case, with the technical detail agents actually need before you install one.
        </p>
      </div>

      {columns.map((col) => (
        <div class="flex flex-col gap-sm">
          <span class="font-mono text-caption-mono uppercase text-mute">{col.label}</span>
          <ul class="flex flex-col gap-xs">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="text-body-sm text-body hover:text-ink">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-3xl flex flex-col gap-xs border-t border-hairline pt-lg text-caption text-mute sm:flex-row sm:items-center sm:justify-between">
      <span>&copy; {year} SkillForAgents.com — an independent, community-curated catalog.</span>
      <span class="font-mono text-caption-mono">Not affiliated with Anthropic or GitHub.</span>
    </div>
  </div>
</footer>
