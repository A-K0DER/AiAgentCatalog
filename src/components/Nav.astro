---
import Icon from "./Icon.astro";
import Button from "./Button.astro";

const links = [
  { href: "/skills/", label: "Skills" },
  { href: "/mcps/", label: "MCPs" },
  { href: "/categories/", label: "Categories" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];

const current = Astro.url.pathname;
---

<header class="sticky top-0 z-50 h-16 border-b border-hairline bg-canvas/95 backdrop-blur">
  <div class="container-page flex h-full items-center justify-between gap-md">
    <a href="/" class="flex items-center gap-2 text-display-sm text-ink">
      <img src="/logo-mark.png" alt="" width="31" height="18" class="h-[18px] w-auto" />
      SkillForAgents
      <span class="font-mono text-caption-mono text-mute">.com</span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-xs">
        {links.map((link) => {
          const active = current === link.href || current.startsWith(link.href);
          return (
            <li>
              <a
                href={link.href}
                aria-current={active ? "page" : undefined}
                class={`inline-flex h-9 items-center rounded-full px-sm text-body-sm transition-colors duration-150 ${
                  active ? "bg-canvas-soft text-ink" : "text-body hover:bg-canvas-soft hover:text-ink"
                }`}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="hidden items-center gap-sm md:flex">
      <button
        type="button"
        id="theme-toggle"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full text-ink hover:bg-canvas-soft"
        aria-label="Switch to dark theme"
      >
        <Icon name="sun" size={18} class="theme-icon-sun" />
        <Icon name="moon" size={18} class="theme-icon-moon" />
      </button>
      <Button href="/submit/" variant="primary-sm">Submit a Listing</Button>
    </div>

    <div class="flex items-center gap-xs md:hidden">
      <button
        type="button"
        id="theme-toggle-mobile"
        class="inline-flex h-11 w-11 items-center justify-center rounded-sm text-ink"
        aria-label="Switch to dark theme"
      >
        <Icon name="sun" size={20} class="theme-icon-sun" />
        <Icon name="moon" size={20} class="theme-icon-moon" />
      </button>

      <button
        type="button"
        id="nav-toggle"
        class="inline-flex h-11 w-11 items-center justify-center rounded-sm text-ink"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

  <div id="mobile-nav" hidden class="border-t border-hairline bg-canvas md:hidden">
    <nav aria-label="Mobile" class="container-page flex flex-col gap-xxs py-md">
      {links.map((link) => (
        <a href={link.href} class="rounded-sm px-sm py-sm text-body-md text-ink hover:bg-canvas-soft">
          {link.label}
        </a>
      ))}
      <a
        href="/submit/"
        class="mt-xs rounded-sm bg-primary px-sm py-sm text-center text-button-md text-on-primary hover:bg-ink/90"
      >
        Submit a Listing
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const panel = document.getElementById("mobile-nav");

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    toggle.setAttribute("aria-label", isOpen ? "Open menu" : "Close menu");
    if (panel) panel.hidden = isOpen;
  });

  function effectiveTheme(): "light" | "dark" {
    const stored = localStorage.getItem("theme");
    if (stored === "light" || stored === "dark") return stored;
    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  }

  function syncLabel(theme: "light" | "dark") {
    const label = theme === "dark" ? "Switch to light theme" : "Switch to dark theme";
    themeButtons.forEach((btn) => btn.setAttribute("aria-label", label));
    const meta = document.querySelector('meta[name="theme-color"]');
    meta?.setAttribute("content", theme === "dark" ? "#0a0a0a" : "#fafafa");
  }

  // Explicit user choice: persists and pins the theme via the [data-theme] attribute
  // (higher precedence than the prefers-color-scheme media query in global.css).
  function setTheme(theme: "light" | "dark") {
    document.documentElement.setAttribute("data-theme", theme);
    localStorage.setItem("theme", theme);
    syncLabel(theme);
  }

  const themeButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("#theme-toggle, #theme-toggle-mobile"),
  );

  // No stored choice yet — just label the toggle correctly; the OS-level
  // preference keeps driving the theme via CSS until the user picks one.
  syncLabel(effectiveTheme());
  themeButtons.forEach((btn) => {
    btn.addEventListener("click", () => setTheme(effectiveTheme() === "dark" ? "light" : "dark"));
  });
</script>
