---
import type { CollectionEntry } from "astro:content";
import VerificationBadge from "./VerificationBadge.astro";
import Badge from "./Badge.astro";
import Icon from "./Icon.astro";
import { getCategory } from "../data/categories";
import { formatCount } from "../lib/format";

interface Props {
  entry: CollectionEntry<"skills"> | CollectionEntry<"mcps">;
  type: "skills" | "mcps";
}

const { entry, type } = Astro.props;
const { name, tagline, categories, verification, pricing, githubStars, addedDate } = entry.data;

const visibleCategories = categories.slice(0, 2);
const pricingLabel = { free: "Free", freemium: "Freemium", paid: "Paid" }[pricing];
---

<a
  href={`/${type}/${entry.id}/`}
  class="entry-row group grid grid-cols-[1.5rem_1fr_auto] items-center gap-md border-b border-hairline px-sm py-sm transition-colors duration-150 hover:bg-canvas-soft sm:grid-cols-[1.5rem_minmax(0,2fr)_minmax(0,1fr)_5rem_5rem]"
  data-entry
  data-name={name.toLowerCase()}
  data-tagline={tagline.toLowerCase()}
  data-categories={categories.join(",")}
  data-clients={entry.data.clients.join(",")}
  data-runtime={entry.data.runtime.join(",")}
  data-pricing={pricing}
  data-stars={githubStars ?? 0}
  data-added={addedDate.valueOf()}
>
  <span class="row-rank text-caption-mono text-mute"></span>

  <span class="flex min-w-0 flex-col gap-0.5">
    <span class="flex items-center gap-xs">
      <span class="truncate text-body-sm-strong text-ink">{name}</span>
      <VerificationBadge status={verification} class="hidden sm:inline-flex" />
    </span>
    <span class="truncate text-caption text-mute sm:hidden">{tagline}</span>
  </span>

  <span class="hidden min-w-0 flex-wrap gap-xs sm:flex">
    {visibleCategories.map((slug) => {
      const cat = getCategory(slug);
      return cat ? <Badge>{cat.label}</Badge> : null;
    })}
  </span>

  <span class="hidden items-center justify-end gap-1 text-caption text-mute sm:flex">
    {githubStars != null && (
      <>
        <Icon name="star" size={12} class="text-mute" />
        {formatCount(githubStars)}
      </>
    )}
  </span>

  <span class="hidden justify-end sm:flex">
    <Badge variant={pricing === "free" ? "default" : "violet"}>{pricingLabel}</Badge>
  </span>
</a>

<style is:global>
  [data-view="list"] {
    counter-reset: entry-row;
  }
  [data-view="list"] .entry-row:not([hidden]) {
    counter-increment: entry-row;
  }
  [data-view="list"] .entry-row .row-rank::before {
    content: counter(entry-row);
  }
</style>
