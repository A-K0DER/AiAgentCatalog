---
import type { CollectionEntry } from "astro:content";
import VerificationBadge from "./VerificationBadge.astro";
import Badge from "./Badge.astro";
import { getCategory } from "../data/categories";

interface Props {
  entry: CollectionEntry<"skills"> | CollectionEntry<"mcps">;
  type: "skills" | "mcps";
}

const { entry, type } = Astro.props;
const { name, tagline, categories, verification, pricing } = entry.data;

const initials = name
  .split(/\s+/)
  .map((w) => w[0])
  .slice(0, 2)
  .join("")
  .toUpperCase();

const visibleCategories = categories.slice(0, 2);
const extraCount = categories.length - visibleCategories.length;

const pricingLabel = { free: "Free", freemium: "Freemium", paid: "Paid" }[pricing];
---

<a
  href={`/${type}/${entry.id}/`}
  class="group flex flex-col gap-md rounded-md bg-canvas p-lg shadow-3 transition-shadow duration-150 hover:shadow-4"
  data-entry
  data-name={name.toLowerCase()}
  data-tagline={tagline.toLowerCase()}
  data-categories={categories.join(",")}
  data-clients={entry.data.clients.join(",")}
  data-runtime={entry.data.runtime.join(",")}
  data-pricing={pricing}
>
  <div class="flex items-start justify-between gap-sm">
    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-canvas-soft-2 text-body-sm-strong text-ink">
      {initials}
    </div>
    <VerificationBadge status={verification} />
  </div>

  <div class="flex flex-col gap-xxs">
    <h3 class="text-display-sm text-ink">{name}</h3>
    <p class="text-body-sm text-body line-clamp-2">{tagline}</p>
  </div>

  <div class="mt-auto flex flex-wrap items-center gap-xs pt-xs">
    {visibleCategories.map((slug) => {
      const cat = getCategory(slug);
      return cat ? <Badge>{cat.label}</Badge> : null;
    })}
    {extraCount > 0 && <Badge>+{extraCount}</Badge>}
    <Badge variant={pricing === "free" ? "default" : "violet"} class="ml-auto">
      {pricingLabel}
    </Badge>
  </div>
</a>
