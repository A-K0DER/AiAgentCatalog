---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import FilterBar from "../../components/FilterBar.astro";
import EntryCard from "../../components/EntryCard.astro";
import EntryRow from "../../components/EntryRow.astro";
import Icon from "../../components/Icon.astro";

const allMcps = (await getCollection("mcps")).sort(
  (a, b) => b.data.addedDate.valueOf() - a.data.addedDate.valueOf(),
);
const officialMcps = allMcps.filter((m) => m.data.officialHosted);
const mcps = allMcps.filter((m) => !m.data.officialHosted);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "MCP Servers",
  itemListElement: allMcps.map((m, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(`/mcps/${m.id}/`, Astro.site).toString(),
    name: m.data.name,
  })),
};
---

<Layout
  title="MCP Server Directory — Browse Model Context Protocol Servers"
  description="The MCP server directory for Model Context Protocol servers and Cursor MCP servers, filterable by category, runtime, client compatibility, and pricing, with verification status on every listing."
  keywords={[
    "mcp server directory",
    "MCP servers",
    "MCP server marketplace",
    "Model Context Protocol servers",
    "AI agent MCP servers",
    "cursor mcp servers",
    "AI agent tools registry",
  ]}
  jsonLd={jsonLd}
>
  <div id="stack-intro-banner" class="border-b border-hairline bg-canvas-soft">
    <div class="container-page flex items-center justify-between gap-md py-sm">
      <p class="flex items-center gap-xs text-body-sm text-body">
        <Icon name="box" size={16} class="hidden shrink-0 text-mute sm:block" />
        Building a setup? Tap <strong class="text-ink">+</strong> on any server below to add it to your stack, then export
        a ready-to-paste config from the <strong class="text-ink">Stack</strong> button.
      </p>
      <button
        type="button"
        id="stack-intro-dismiss"
        aria-label="Dismiss"
        class="shrink-0 rounded-full p-1 text-mute hover:bg-canvas-soft-2 hover:text-ink"
      >
        <Icon name="x" size={14} />
      </button>
    </div>
  </div>

  {officialMcps.length > 0 && (
    <Section
      eyebrow="Official & hosted"
      title="Vendor-hosted MCP servers"
      description="Servers published and hosted by the vendor itself — connected by an authenticated endpoint or an official package, not compared by GitHub stars alone."
    >
      <div class="grid grid-cols-1 gap-lg sm:grid-cols-2 lg:grid-cols-3">
        {officialMcps.map((entry) => <EntryCard entry={entry} type="mcps" />)}
      </div>
    </Section>
  )}

  <Section
    eyebrow="MCP Servers"
    title="Browse Community & Reference MCPs"
    description="Model Context Protocol servers that connect an agent to a real system — a database, a browser, an API — over a standard interface."
  >
    <FilterBar type="mcps" />
    <div id="results" data-view="grid" class="mt-xl">
      <div id="grid-view" class="grid grid-cols-1 gap-lg sm:grid-cols-2 lg:grid-cols-3">
        {mcps.map((entry) => <EntryCard entry={entry} type="mcps" />)}
      </div>
      <div id="list-view" data-view="list" class="rounded-md border border-hairline bg-canvas">
        {mcps.map((entry) => <EntryRow entry={entry} type="mcps" />)}
      </div>
    </div>
    <div
      id="empty-state"
      hidden
      class="mt-xl rounded-lg border border-dashed border-hairline-strong px-lg py-3xl text-center"
    >
      <p class="text-body-md-strong text-ink">No results match your filters</p>
      <p class="mt-xxs text-body-sm text-body">Try clearing a filter or searching a different term.</p>
    </div>
  </Section>
</Layout>

<script>
  const DISMISS_KEY = "stack-intro-dismissed";
  const banner = document.getElementById("stack-intro-banner");
  const dismissBtn = document.getElementById("stack-intro-dismiss");

  try {
    if (localStorage.getItem(DISMISS_KEY) === "1" && banner) banner.hidden = true;
  } catch {
    /* localStorage unavailable — leave banner visible */
  }

  dismissBtn?.addEventListener("click", () => {
    if (banner) banner.hidden = true;
    try {
      localStorage.setItem(DISMISS_KEY, "1");
    } catch {
      /* localStorage unavailable — dismissal won't persist */
    }
  });
</script>
