---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import EntryCard from "../components/EntryCard.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import Faq from "../components/Faq.astro";
import { CATEGORIES, type CategorySlug } from "../data/categories";

const skills = await getCollection("skills");
const mcps = await getCollection("mcps");

const featuredSkills = skills.filter((s) => s.data.featured).slice(0, 3);
const featuredMcps = mcps.filter((m) => m.data.featured).slice(0, 3);

function categoryCount(slug: CategorySlug) {
  return (
    skills.filter((s) => s.data.categories.includes(slug)).length +
    mcps.filter((m) => m.data.categories.includes(slug)).length
  );
}

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "SkillForAgents",
    url: Astro.site,
    description:
      "The open, verified catalog of Claude Agent Skills and MCP servers, browsable by use case.",
    potentialAction: {
      "@type": "SearchAction",
      target: `${Astro.site}skills/?q={search_term_string}`,
      "query-input": "required name=search_term_string",
    },
  },
];

const faqItems = [
  {
    question: "What are AI agent skills?",
    answer:
      "AI agent skills are packaged instructions, scripts, and resources that an AI agent like Claude loads on demand to perform a specific task well — for example editing a spreadsheet, generating a PDF, or reviewing code. They extend what an agent can do beyond its base model, without retraining it.",
  },
  {
    question: "How do agent skills work?",
    answer:
      "Each skill ships as a folder with a short description, a set of instructions, and optional scripts or reference files. The agent scans the available skills' descriptions, decides which one is relevant to the current task, and only then loads its full instructions into context — so skills stay cheap to have installed and expensive only when actually used.",
  },
  {
    question: "What are the common types and categories of agent skills?",
    answer:
      "Skills are usually grouped by the job they do rather than by vendor: web scraping, database administration, DevOps and CI/CD, browser automation, search and research, full-stack coding, documents and files, communication, data and analytics, and productivity or memory tooling. SkillForAgents uses this same use-case taxonomy so you can browse by task instead of by name.",
  },
  {
    question: "What are the best AI skills for agents?",
    answer:
      "There isn't a single best skill — a skill for generating polished PDFs isn't useful for a database migration task. Instead, look for skills that are actively maintained, clearly document their required environment variables and runtime, and are verified against their source repository, which is exactly what every listing on SkillForAgents shows before you install anything.",
  },
  {
    question: "What is an MCP server?",
    answer:
      "An MCP (Model Context Protocol) server is a standard interface that connects an AI agent to a real system — a database, a browser, a search API, or a file system — so the agent can take real actions instead of only generating text.",
  },
  {
    question: "What's the difference between an AI agent skill and an MCP server?",
    answer:
      "A skill is a set of instructions and resources an agent loads into its own context to perform a task. An MCP server is a live connection to an external system — a database, browser, or API — that the agent calls out to and gets real results back from. Skills teach an agent how to do something; MCP servers give it something new to act on.",
  },
  {
    question: "Is SkillForAgents free to use?",
    answer:
      "Yes. Browsing the AI agent skills directory and MCP server directory is free, and every listing links to its original source so you can install it directly.",
  },
  {
    question: "How do I submit a skill or MCP server to the directory?",
    answer:
      "Submissions go through a public GitHub issue template linked from the Submit page — no account required. You fill in a structured form covering the runtime, required environment variables, and client compatibility, and it's reviewed before being added to the catalog.",
  },
  {
    question: "What is AI Claude used for?",
    answer:
      "Claude is Anthropic's family of AI models, used for tasks like writing and editing, coding and debugging, research and summarization, and data analysis — and, through Claude Code and Claude Agent Skills, for autonomous multi-step work like running scripts, browsing the web, and operating on files directly.",
  },
  {
    question: "Is Claude AI free to use?",
    answer:
      "Claude offers a free tier with usage limits at claude.ai, alongside paid Pro, Max, Team, and Enterprise plans for higher usage and additional features. Developers can also access Claude models through the Claude API on a pay-per-token basis.",
  },
  {
    question: "Is Claude AI better than ChatGPT?",
    answer:
      "Neither is universally better — they're built by different companies on different models and each has areas it's stronger in. Claude is often favored for coding, long-context reasoning, and following detailed instructions, while ChatGPT has a larger plugin and app ecosystem. The right choice depends on the task, not a blanket ranking.",
  },
  {
    question: "Why is Claude controversial?",
    answer:
      "Discussion around Claude — like most frontier AI models — tends to center on a few recurring topics: how training data was sourced, the computational cost of running large models, concerns about AI automating knowledge work, and ongoing debate over how much autonomy AI agents should be given to take real-world actions. These are industry-wide questions, not issues unique to Claude.",
  },
  {
    question: "What exactly does Cursor do?",
    answer:
      "Cursor is an AI-powered code editor, built on top of VS Code, that integrates AI chat, inline code generation, and agentic multi-file editing directly into the development workflow. It can read your codebase, propose and apply multi-file changes, and connect to MCP servers to pull in external context like databases or documentation.",
  },
  {
    question: "Is Cursor better than ChatGPT?",
    answer:
      "They're not really direct competitors — Cursor is a code editor with AI built in, while ChatGPT is a general-purpose conversational assistant. Many developers use both: a chat assistant like ChatGPT or Claude for broader research and reasoning, and Cursor for the in-editor loop of writing, running, and fixing code.",
  },
  {
    question: "What exactly is ChatGPT used for?",
    answer:
      "ChatGPT is OpenAI's conversational AI product, used for writing, answering questions, coding help, research, and image generation — and, through its agent and tool-calling features, for automating multi-step tasks that call out to external tools.",
  },
  {
    question: "What's the difference between AI and GPT?",
    answer:
      "AI (artificial intelligence) is the broad field of building systems that perform tasks normally requiring human intelligence. GPT (Generative Pre-trained Transformer) is one specific model architecture within that field — the large language model family behind ChatGPT — and it's one implementation among several approaches, alongside model families like Claude, Gemini, and Llama.",
  },
  {
    question: "What does \"agentic\" mean in AI agents?",
    answer:
      "\"Agentic\" describes an AI system that can plan and take a sequence of actions toward a goal — calling tools, running code, browsing the web — rather than just returning a single text response. Agent skills and MCP servers are the two main ways agentic systems like Claude Code gain new capabilities.",
  },
  {
    question: "Which AI agents support Claude Agent Skills?",
    answer:
      "Claude Agent Skills work in Claude.ai, Claude Code, and API-based agents built with the Claude Agent SDK. Check each listing on SkillForAgents for its documented client compatibility before installing.",
  },
];

const comparisonRows = [
  { feature: "Per-listing required environment variables", us: true, them: false },
  { feature: "Runtime environment (npx / docker / uv / Python)", us: true, them: false },
  { feature: "Client compatibility tags", us: true, them: false },
  { feature: "Maintenance / verification status", us: true, them: false },
  { feature: "Dedicated MCP server catalog", us: true, them: false },
  { feature: "Category + client + runtime filtering", us: true, them: "Limited" },
];
---

<Layout
  title="AI Agent Skills & MCP Server Directory"
  description="The AI agent skills directory for Claude agent skills and MCP servers. Browse a verified catalog of agentic workflow integrations by use case, with the environment variables, runtime, and client compatibility every listing needs."
  keywords={[
    "AI agent skills",
    "AI agent skills directory",
    "AI agent skills library",
    "AI agent skills marketplace",
    "AI agent skills catalog",
    "mcp server directory",
    "model context protocol skills",
    "claude agent skills",
    "cursor mcp servers",
    "ai agent tools registry",
    "agentic workflow integrations",
    "claude code tools",
    "custom agent skills exporter",
  ]}
  jsonLd={jsonLd}
>
  <Hero
    eyebrow="The open catalog for agent tooling"
    title="Find the right skill or MCP before you wire it in."
    subtitle="A curated, verified catalog of Claude Agent Skills and MCP servers — organized by use case, with the environment variables, runtime, and client compatibility every listing actually needs."
    primaryCta={{ label: "Browse Skills", href: "/skills/" }}
    secondaryCta={{ label: "Browse MCPs", href: "/mcps/" }}
  />

  <div class="border-y border-hairline bg-canvas">
    <div class="container-page grid grid-cols-3 divide-x divide-hairline py-lg">
      <div class="flex flex-col items-center gap-xxs px-sm text-center">
        <span class="text-display-lg text-ink">{skills.length}</span>
        <span class="text-body-sm text-body">Agent Skills</span>
      </div>
      <div class="flex flex-col items-center gap-xxs px-sm text-center">
        <span class="text-display-lg text-ink">{mcps.length}</span>
        <span class="text-body-sm text-body">MCP Servers</span>
      </div>
      <div class="flex flex-col items-center gap-xxs px-sm text-center">
        <span class="text-display-lg text-ink">{CATEGORIES.length}</span>
        <span class="text-body-sm text-body">Use-Case Categories</span>
      </div>
    </div>
  </div>

  <Section
    eyebrow="Taxonomy"
    title="Browse by use case, not by vendor."
    description="Every listing is tagged against a fixed set of operational objectives — pick the job you're automating, not the brand name."
  >
    <div class="grid grid-cols-1 gap-md sm:grid-cols-2 lg:grid-cols-5">
      {CATEGORIES.map((cat) => (
        <a
          href={`/skills/category/${cat.slug}/`}
          class="flex flex-col gap-sm rounded-md border border-hairline bg-canvas p-lg transition-shadow duration-150 hover:shadow-3"
        >
          <Icon name={cat.icon} size={22} class="text-ink" />
          <span class="text-body-md-strong text-ink">{cat.label}</span>
          <span class="text-caption text-mute">{categoryCount(cat.slug)} listings</span>
        </a>
      ))}
    </div>
  </Section>

  <Section eyebrow="Featured" title="Skills worth knowing about" soft>
    <div class="grid grid-cols-1 gap-lg sm:grid-cols-2 lg:grid-cols-3">
      {featuredSkills.map((entry) => <EntryCard entry={entry} type="skills" />)}
    </div>
    <div class="mt-xl">
      <Button href="/skills/" variant="secondary">
        View all Skills <Icon name="arrow-right" size={16} />
      </Button>
    </div>
  </Section>

  <Section eyebrow="Featured" title="MCP servers worth knowing about">
    <div class="grid grid-cols-1 gap-lg sm:grid-cols-2 lg:grid-cols-3">
      {featuredMcps.map((entry) => <EntryCard entry={entry} type="mcps" />)}
    </div>
    <div class="mt-xl">
      <Button href="/mcps/" variant="secondary">
        View all MCPs <Icon name="arrow-right" size={16} />
      </Button>
    </div>
  </Section>

  <Section
    eyebrow="Why this catalog"
    title="Most directories stop at a name and a link."
    description="We built this after finding the same gap across existing agent-tooling directories: no technical metadata, no verification status, and no MCP coverage at all. Here's what every listing on SkillForAgents includes by default."
    soft
  >
    <div class="overflow-x-auto rounded-lg border border-hairline bg-canvas">
      <table class="w-full min-w-[560px] text-left">
        <thead>
          <tr class="border-b border-hairline text-caption-mono uppercase text-mute">
            <th class="px-lg py-sm font-mono font-normal">Feature</th>
            <th class="px-lg py-sm font-mono font-normal">SkillForAgents</th>
            <th class="px-lg py-sm font-mono font-normal">Typical directory</th>
          </tr>
        </thead>
        <tbody>
          {comparisonRows.map((row) => (
            <tr class="border-b border-hairline last:border-0">
              <td class="px-lg py-sm text-body-sm text-ink">{row.feature}</td>
              <td class="px-lg py-sm">
                {row.us === true ? (
                  <Icon name="check" size={18} class="text-link" />
                ) : (
                  <span class="text-body-sm text-body">{row.us}</span>
                )}
              </td>
              <td class="px-lg py-sm">
                {row.them === false ? (
                  <Icon name="x" size={18} class="text-mute" />
                ) : (
                  <span class="text-body-sm text-body">{row.them}</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Section>

  <Section
    eyebrow="About the directory"
    title="What is SkillForAgents?"
    soft
  >
    <div class="prose-content max-w-[68rem] text-body-md text-body [&_h3]:mb-sm [&_h3]:mt-xl [&_h3]:text-display-sm [&_h3]:text-ink [&_p]:mb-md [&_ul]:mb-md [&_ul]:list-disc [&_ul]:pl-lg [&_li]:mb-xxs">
      <p>SkillForAgents is an <strong>AI agent skills directory</strong> and MCP server directory built for one job: helping you find the right <strong>AI agent skills</strong> and Model Context Protocol integrations before you wire them into a real agent. Most general-purpose lists of "AI agent tools" stop at a name, a logo, and an outbound link. This one goes further — every entry in the <strong>agent skills library</strong> is tagged with its runtime, required environment variables, client compatibility, and verification status, so you can evaluate it without opening a repository first.</p>

      <h3>An AI agent skills catalog organized by use case</h3>
      <p>Rather than sorting by vendor, the <strong>AI agent skills database</strong> is organized by the operational objective a skill or MCP server solves. Whether you're looking for <strong>Claude agent skills</strong>, <strong>Claude Code skills</strong>, or <strong>Cursor MCP servers</strong>, you can browse by category — web scraping, database administration, DevOps and CI/CD, browser automation, search and research, full-stack coding, documents and files, communication, data and analytics, or productivity and memory — instead of scrolling an alphabetical list. That taxonomy makes this an effective <strong>AI agent skill finder</strong> for teams evaluating <strong>agentic workflow integrations</strong> at scale, not just a single tool.</p>

      <h3>A dedicated MCP server directory</h3>
      <p>Model Context Protocol has quickly become the standard way to connect an agent to a real system — a database, a browser, a search index, a filesystem. This <strong>MCP server directory</strong> tracks reference servers, community builds, and first-party integrations side by side with <strong>Claude agent skills</strong>, so you don't need a second site to compare a <strong>Model Context Protocol skill</strong> against a native Claude skill for the same job. Each MCP listing documents its install command, runtime (npx, Docker, uv/Python, or a compiled binary), and every required API key, which is the detail most <strong>AI agent tools registry</strong> sites leave out entirely.</p>

      <h3>Built for people building AI agents</h3>
      <p>If you're one of the growing number of engineers, indie builders, or platform teams assembling agentic systems, this catalog is meant to save you the research time. It works as an <strong>AI agent skill search</strong> tool when you know roughly what you need, and as a discovery surface — <strong>best AI agent skills</strong>, trending <strong>Claude Code tools</strong>, and newly added <strong>OpenAI agent skills</strong> and <strong>Cursor agent skills</strong> — when you're still exploring what's possible. Teams use it to find <strong>AI agent skills for developers</strong>, <strong>AI agent skills for DevOps</strong>, <strong>AI agent skills for data analysis</strong>, <strong>AI agent skills for web scraping</strong>, and <strong>AI agent skills for code review</strong>, alongside skills built for marketing, sales, customer support, research, automation, and SEO workflows.</p>

      <h3>Verified, not just listed</h3>
      <p>Every listing carries a verification badge — verified, community, or unverified — so you know whether a skill or MCP server is actively maintained before you depend on it. We don't run a <strong>custom agent skills exporter</strong> or generate listings automatically; every entry in this <strong>agent skills marketplace</strong> is checked against its source repository. If you're building or maintaining your own <strong>AI agent toolkit</strong> and want it discoverable in a directory that treats technical detail as a requirement rather than an afterthought, <a href="/submit/" class="text-link hover:underline">submit a listing</a> — it takes a structured GitHub issue, not an account.</p>

      <h3>How to find the right skill fast</h3>
      <p>Use the category filters if you already know the job — say, an MCP server for database administration or a Claude skill for spreadsheet generation. Use the search bar as an <strong>AI agent skill search</strong> shortcut when you know part of a name. And check back regularly: this is a living <strong>AI agent skills resource</strong>, not a static list, with new <strong>skills for AI agents</strong> and <strong>tools for building AI agents</strong> added as the ecosystem around Claude, Cursor, Codex, and other agent runtimes keeps expanding.</p>
    </div>
  </Section>

  <Section
    eyebrow="FAQ"
    title="Common questions"
    description="Agent skills, MCP servers, and where Claude, ChatGPT, and Cursor fit in — answered in one place."
  >
    <Faq items={faqItems} />
  </Section>

  <section class="bg-primary py-4xl sm:py-5xl">
    <div class="container-page flex flex-col items-start gap-md">
      <h2 class="text-display-lg text-on-primary">Built something worth listing?</h2>
      <p class="max-w-[36rem] text-body-lg text-on-primary/70">
        Submissions go through a public GitHub issue template — no account, no gatekeeping,
        just a structured form so every listing ships with the metadata this catalog needs.
      </p>
      <Button href="/submit/" variant="secondary">Submit a Listing</Button>
    </div>
  </section>
</Layout>
