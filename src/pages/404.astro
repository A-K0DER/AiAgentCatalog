---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
---

<Layout title="Page Not Found" description="The page you're looking for doesn't exist." noIndex>
  <section class="container-page flex flex-col items-start gap-md py-5xl">
    <span class="font-mono text-caption-mono text-mute">404</span>
    <h1 class="text-display-xl text-ink">This page doesn't exist.</h1>
    <p class="max-w-[32rem] text-body-lg text-body">
      The listing or page you're looking for may have moved, or the link might be out of date.
    </p>
    <div class="flex flex-wrap gap-md">
      <Button href="/" variant="primary">Back to Home</Button>
      <Button href="/skills/" variant="secondary">Browse Skills</Button>
    </div>
  </section>
</Layout>
